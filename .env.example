# ==============================================================================
# PROJECT J.A.R.V.I.S. - ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI Model API Keys (Obtain free keys: Google AI Studio & Groq Console)
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434


# Core Server Settings
JARVIS_ENV=local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO

# Security Passphrase (REQUIRED: Server will refuse startup if unset)
JARVIS_MASTER_SECRET=replace_with_your_strong_passphrase
EMERGENCY_STAND_DOWN=false

# Physical & Cloud World Settings
LOCAL_MQTT_BROKER=127.0.0.1
LOCAL_MQTT_PORT=1883
AWS_REGION=us-east-1
AWS_EVENT_BUS_NAME=jarvis-event-bus
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://127.0.0.1:4566
